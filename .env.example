DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=

# DeepSeek generation defaults. Leave MAX_TOKENS unset for adaptive budgets.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS_CAP=6000

# Optional access control. If set, all API routes except /api/health require:
# Authorization: Bearer <APP_ACCESS_TOKEN>
APP_ACCESS_TOKEN=

# Optional Qdrant vector backend. If not set, FAISS is used.
QDRANT_URL=
QDRANT_COLLECTION=
QDRANT_API_KEY=
